generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())

  fullName  String
  studentId String @unique

  email String @unique

  institution String
  class       Int

  guardianPhone String

  division String?
  district String?
  thana    String?

  password String

  profileImg String?

  role Role @default(student)

  status Status @default(active)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  blogPosts BlogPost[]
}

model GalleryImage {
  id        String   @id @default(uuid())
  imageUrl  String
  alt       String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model HomeVideo {
  id             String   @id @default(uuid())
  name           String
  nameEn         String   @default("")
  title          String
  titleEn        String   @default("")
  videoLink      String
  videoLinkEn    String   @default("")
  thumbnailImage String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([createdAt])
}

model Story {
  id             String   @id @default(uuid())
  quoteBn        String
  quoteEn        String
  authorNameBn   String
  authorNameEn   String
  authorDetailBn String
  authorDetailEn String
  imageUrl       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([createdAt])
}

model PdfResource {
  id             String              @id @default(uuid())
  category       PdfResourceCategory
  titleBn        String
  titleEn        String
  descriptionBn  String
  descriptionEn  String
  pdfUrl         String
  pdfUrlEn       String?
  featuredImageUrl String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([category, createdAt])
}

model BlogPost {
  id          String        @id @default(uuid())
  title         String
  titleEn       String        @default("")
  content       String
  contentEn     String        @default("")
  featuredImage String?
  status        BlogStatus @default(pending)
  authorId    String
  author      User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status, createdAt])
  @@index([authorId])
}

enum Role {
  student
  admin
}

enum Status {
  active
  blocked
}

enum BlogStatus {
  pending
  published
}

enum PdfResourceCategory {
  comics
  flyer
  pressRelease
}

model School {
  id          Int          @id @default(autoincrement())
  locationKey String       
  nameBn      String
  nameEn      String
  videoLink   String?
  addressBn   String
  addressEn   String
  descBn      String
  descEn      String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  members     ClubMember[]
}

model ClubMember {
  id        Int      @id @default(autoincrement())
  schoolId  Int
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  nameBn    String
  nameEn    String
  classBn   String
  classEn   String
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())

  fullName  String
  studentId String @unique

  email String @unique

  institution String
  class       Int

  guardianPhone String

  division String?
  district String?
  thana    String?

  password String

  profileImg String?

  role Role @default(student)

  status Status @default(active)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  blogPosts BlogPost[]
}

model IsChapterComplete {
  userId     String
  chapterId  Int
  quizLevel  QuizLevel?
  isComplete Boolean    @default(false)

  @@id([userId, chapterId])
}

model LearningContent {
  id        Int      @id @default(autoincrement())
  chapterId Int      @unique
  sections  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tutorial {
  id             Int      @id @default(autoincrement())
  tutorialNumber Int      @unique
  name           String
  title          String
  thumbnailImage String
  videoLink      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model GalleryImage {
  id        String   @id @default(uuid())
  imageUrl  String
  alt       String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model BlogPost {
  id          String        @id @default(uuid())
  title         String
  content       String
  featuredImage String?
  status        BlogStatus @default(pending)
  authorId    String
  author      User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status, createdAt])
  @@index([authorId])
}

enum Role {
  student
  admin
}

enum Status {
  active
  blocked
}

enum BlogStatus {
  pending
  published
}

enum QuizLevel {
  easy
  medium
  hard
}

model School {
  id          Int          @id @default(autoincrement())
  locationKey String       
  nameBn      String
  nameEn      String
  videoLink   String?
  addressBn   String
  addressEn   String
  descBn      String
  descEn      String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  members     ClubMember[]
}

model ClubMember {
  id        Int      @id @default(autoincrement())
  schoolId  Int
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  nameBn    String
  nameEn    String
  classBn   String
  classEn   String
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

